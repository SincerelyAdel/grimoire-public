{
  "name": "adels-grimoire",
  "displayName": "Adel's Grimoire",
  "description": "Hover documentation for every SystemVerilog keyword and the UVM library",
  "version": "1.0.5",
  "publisher": "adel-saer-aljaed",
  "author": {
    "name": "Adel Saer F. Aljaed"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "systemverilog",
    "verilog",
    "uvm",
    "hover",
    "documentation",
    "reference",
    "keywords"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "lookup.js",
    "uvm.js",
    "icon.png",
    "LICENSE.txt",
    "README.md",
    "CHANGELOG.md",
    "library/**",
    "uvm-core/src/**",
    "uvm-core/LICENSE.txt",
    "uvm-core/NOTICE.txt"
  ],
  "extensionDependencies": [
    "hudson-river-trading.vscode-slang"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grimoire.enable",
        "title": "Enable",
        "category": "Grimoire"
      },
      {
        "command": "grimoire.disable",
        "title": "Disable",
        "category": "Grimoire"
      },
      {
        "command": "grimoire.setUvmPath",
        "title": "Set UVM Path",
        "category": "Grimoire"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "grimoire.enable",
          "when": "!grimoire.enabled"
        },
        {
          "command": "grimoire.disable",
          "when": "grimoire.enabled"
        }
      ]
    },
    "configuration": {
      "title": "Grimoire",
      "properties": {
        "grimoire.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Grimoire hovers and keep slang pointed at a UVM library. Also toggled with the Grimoire: Enable and Grimoire: Disable commands."
        },
        "grimoire.uvmPath": {
          "type": "string",
          "default": "",
          "description": "UVM library for slang, as the UVM folder or its src folder. Empty uses UVM_HOME, or the UVM bundled with Grimoire when UVM_HOME is not set. Also set with the Grimoire: Set UVM Path command."
        },
        "grimoire.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra documentation folders, searched before the built-in SystemVerilog and UVM pages. Each holds subfolders of <name>.md pages; the sv and uvm subfolders apply only to SystemVerilog files, any other subfolder to every file."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SincerelyAdel/grimoire-public",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/SincerelyAdel/grimoire-public/issues"
  },
  "homepage": "https://github.com/SincerelyAdel/grimoire-public#readme"
}

page: uvm_driver
---
class ${1:example}_rd_driver extends uvm_driver #(${1}_transaction);

    // ── Interface ──────────────────────────────────────────────────────────────
    virtual ${1}_if vif;

    // ── Factory Registration ───────────────────────────────────────────────────
    `uvm_component_utils(${1}_rd_driver)

    // ── Constructor ────────────────────────────────────────────────────────────
    function new(string name, uvm_component parent);
        super.new(name, parent);
    endfunction

    // ── Build ──────────────────────────────────────────────────────────────────
    function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        if (!uvm_config_db #(virtual ${1}_if)::get(this, "", "vif", vif))
            `uvm_fatal("NOVIF", "${1}_if not found in config_db")
    endfunction

    // ── Run ────────────────────────────────────────────────────────────────────
    task run_phase(uvm_phase phase);
        vif.rd_drv_cb.rd_en <= 1'b0;
        wait (vif.rst_n === 1'b1);
        @(vif.rd_drv_cb);
        forever begin
            seq_item_port.get_next_item(req);
            repeat (req.${2:delay}) @(vif.rd_drv_cb);
            vif.rd_drv_cb.rd_en <= 1'b1;
            @(vif.rd_drv_cb);
            vif.rd_drv_cb.rd_en <= 1'b0;
            seq_item_port.item_done();
        end
    endtask

endclass
$0

page: uvm_sequence_item
---
class ${1:example}_transaction extends uvm_sequence_item;

    // ── Stimulus ───────────────────────────────────────────────────────────────
    rand logic [${2:7}:0]  ${3:data};
    rand int unsigned ${4:delay};

    // ── Response ───────────────────────────────────────────────────────────────
    bit ${5:accepted};

    // ── Constraints ────────────────────────────────────────────────────────────
    constraint ${4}_c { ${4} inside {[0:${6:3}]}; }

    // ── Factory Registration ───────────────────────────────────────────────────
    `uvm_object_utils_begin(${1}_transaction)
        `uvm_field_int(${3}, UVM_ALL_ON)
        `uvm_field_int(${4}, UVM_ALL_ON | UVM_NOCOMPARE)
        `uvm_field_int(${5}, UVM_ALL_ON)
    `uvm_object_utils_end

    // ── Constructor ────────────────────────────────────────────────────────────
    function new(string name = "${1}_transaction");
        super.new(name);
    endfunction

    // ── String Conversion ──────────────────────────────────────────────────────
    function string convert2string();
        return \$sformatf("${3}=0x%0h ${4}=%0d ${5}=%0b", ${3}, ${4}, ${5});
    endfunction

endclass
$0
